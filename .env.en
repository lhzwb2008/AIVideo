# 英文 US Market 流水线专属（./make-us-publish.sh）
# 共享 API 密钥在 .env

AIVIDEO_LOCALE=en
AIVIDEO_SOURCE=cursor
AIVIDEO_FORUM_POST=0
AIVIDEO_MAX_VIDEOS_PER_RUN=4
BATCH_HISTORY_DAYS=7

# ── TTS：豆包内置男声（非克隆）──────────────────────────────────
US_TTS_VOICE=yunzhou
TTS_PROVIDER=doubao
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SPEAKER=zh_male_m191_uranus_bigtts
VOLCENGINE_TTS_ATEMPO=1.08
DASHSCOPE_TTS_PREPROCESS=0
DASHSCOPE_TTS_SSML=0
DASHSCOPE_TTS_SEGMENT=0

# ── 品牌 / 尾页 ─────────────────────────────────────────────────
AIVIDEO_BRAND_NAME=Market Sketch
AIVIDEO_BRAND_TAGLINE=US markets in plain English
AIVIDEO_OUTRO_HEADLINE=Like · Save · Follow
AIVIDEO_OUTRO_SUBLINE=US markets in plain English
AIVIDEO_OUTRO_NARRATION=That's the sketch for today. Save it if useful — and tell me what you'd watch next.
AIVIDEO_OUTRO_NARRATION_VARIANTS=That's the sketch for today. Save it if useful — and tell me what you'd watch next.|Quick market sketch. Save this for later and follow for the next one.|That's today's sketch. Bookmark it if it helped — follow for daily updates.|Market Sketch signing off. Save this episode and follow for the next move.|That's the wrap. If this clarified anything, save it — tell us what to cover next.|Plain-English markets, one sketch at a time. Save, follow, see you tomorrow.

# ── 合成 ───────────────────────────────────────────────────────
AIVIDEO_COLD_OPEN_MIN_S=2.5
AIVIDEO_COLD_OPEN_MAX_S=4.5
AIVIDEO_COLD_OPEN_FX=impact
AIVIDEO_COVER_DURATION_S=0.8
AIVIDEO_BGM_ENABLED=1
AIVIDEO_BGM_DIR=assets/bgm
AIVIDEO_BGM_VOLUME=0.35
AIVIDEO_DOUYIN_COMPLIANCE_STRICT=0

# ── 发布：仅 YouTube + TikTok ───────────────────────────────────
AIVIDEO_PUBLISH_DOUYIN=0
AIVIDEO_PUBLISH_XHS=0
AIVIDEO_PUBLISH_SHIPINHAO=0
AIVIDEO_PUBLISH_BILIBILI=0
AIVIDEO_PUBLISH_YOUTUBE=1
AIVIDEO_PUBLISH_TIKTOK=1
AIVIDEO_PUBLISH_INSTAGRAM=1
AIVIDEO_PUBLISH_FACEBOOK=1
AIVIDEO_PUBLISH_LINKEDIN=1
US_SOCIAL_HEADLESS=1
AIVIDEO_PUBLISH_EASTMONEY=0
AIVIDEO_PUBLISH_XUEQIU=0
AIVIDEO_PUBLISH_WECHAT=0
AIVIDEO_PUBLISH_ZHIHU=0

# ── 话题 / 免责声明 ─────────────────────────────────────────────
YOUTUBE_HASHTAGS=#stocks #USmarket #finance #investing #Shorts
TIKTOK_HASHTAGS=#stocks #finance #investing #wallstreet #money
YOUTUBE_DISCLAIMER=For education only. Not investment advice.
TIKTOK_DISCLAIMER=For education only. Not investment advice.

# ── YouTube / TikTok API ─────────────────────────────────────────
YOUTUBE_HTTP_PROXY=http://127.0.0.1:7897
TIKTOK_HTTP_PROXY=http://127.0.0.1:7897
TIKTOK_SCOPES=user.info.basic,video.upload
TIKTOK_POST_MODE=inbox
TIKTOK_PRIVACY=SELF_ONLY
