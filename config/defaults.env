# AI财知道 默认配置（随代码更新，git pull 即生效）
# 优先级：进程环境变量 > .env > 本文件。.env 只放密钥和账号标识；要改某项，在 .env 里写同名一行即可覆盖。
# 本仓库公开，这里不要写密钥、bucket、AppID 等账号信息。
#== section: shared ==

# ---- 选题 + 写稿：Cursor Cloud Agent（沙箱仓库地址在 .env） ----
CURSOR_MODEL_ID=claude-sonnet-5-5
AIVIDEO_CURSOR_REUSE_AGENT=1

# ---- AiHubMix：生图 + 改编 + 浏览器填表 ----
AIHUBMIX_BASE_URL=https://api.inferera.com/v1
AIHUBMIX_IMAGE_MODEL=gpt-image-2
AIHUBMIX_IMAGE_SIZE=1024x1536
AIHUBMIX_IMAGE_QUALITY=low
AIHUBMIX_IMAGE_TIMEOUT=300
AIHUBMIX_TEXT_MODEL=claude-opus-5-5
AIVIDEO_AI_COVER=1
AIVIDEO_MAX_SLIDES=4

# ---- 画面：explainer = 漫画插图 + 动态 PPT 动画 + 自动配乐（失败自动退回 comic 生图版） ----
AIVIDEO_VISUAL_MODE=explainer
AIVIDEO_EXPLAINER_WORKERS=4
AIVIDEO_EXPLAINER_FALLBACK=1
# 导演模型（版式、插图画面、节奏、金句、配音语气），留空用 claude-opus-5-5
AIVIDEO_EXPLAINER_MODEL=
# 帧率；服务器渲染太慢可改 30
AIVIDEO_EXPLAINER_FPS=60
# 每页插图（gpt-image-2），质量 low/medium/high；关掉 = 纯动画
AIVIDEO_EXPLAINER_ART=1
AIVIDEO_EXPLAINER_ART_QUALITY=high
# 自动配乐 + 音效卡点；关掉 = 用 assets/bgm
AIVIDEO_EXPLAINER_SCORE=1

# ---- 冷开场 ----
AIVIDEO_COLD_OPEN_FX=impact
AIVIDEO_COLD_OPEN_MIN_S=2.5
AIVIDEO_COLD_OPEN_MAX_S=4.5
AIVIDEO_COLD_OPEN_AUDIO_MAX_S=8.0
AIVIDEO_COVER_DURATION_S=0.8

# ---- LLM 浏览器发布 ----
LLM_BROWSER_MODEL=claude-sonnet-5-5
LLM_BROWSER_MAX_STEPS=20
LLM_BROWSER_USE_PROFILE=1
LLM_BROWSER_SAVE_SCREENSHOTS=0

# ---- 豆包 TTS，百炼备用 ----
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_UID=aivideo
VOLCENGINE_TTS_FORMAT=mp3
VOLCENGINE_TTS_SAMPLE_RATE=24000
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 吉祥物片头 OSS（bucket 和密钥在 .env） ----
OSS_URL_MODE=signed
OSS_SIGNED_URL_SECONDS=604800

# ---- Exa（深读原文） ----
EXA_TIMEOUT=180

# ---- 合成 ----
AIVIDEO_FONT=assets/HiraginoSansGB.ttc
AIVIDEO_BRAND_BADGE_X=86
AIVIDEO_BRAND_BADGE_Y=150
AIVIDEO_IMAGE_TOP_SAFE_Y=150
AIVIDEO_BGM_ENABLED=1
AIVIDEO_BGM_DIR=assets/bgm

# ---- 发布账号（SAU_BIN 是服务器路径，在 .env） ----
SAU_DOUYIN_ACCOUNT=main
SAU_BILIBILI_ACCOUNT=main
SAU_XHS_ACCOUNT=main
SAU_SHIPINHAO_ACCOUNT=main
EASTMONEY_ACCOUNT=main
EASTMONEY_DEFAULT_TOPIC=社区牛人计划
XUEQIU_ACCOUNT=main
ZHIHU_ACCOUNT=main

#== section: zh ==

AIVIDEO_HOST_INTRO=1
AIVIDEO_DAYS=1
AIVIDEO_MAX_VIDEOS_PER_RUN=2
BATCH_HISTORY_DAYS=3
AIVIDEO_THEME_DEDUP_DAYS=7
AIVIDEO_THEME_MAX_PER_DAY=1
AIVIDEO_EDU_DEDUP_DAYS=3650
AIVIDEO_WEEKEND_MAX_VIDEOS=3
AIVIDEO_FORUM_POST=0
AIVIDEO_COMPLIANCE_RELAXED=1
AIVIDEO_DOUYIN_COMPLIANCE_STRICT=1

TTS_PROVIDER=doubao
# 音色：官方 2.0 霸气青叔，资源 ID 自动用 seed-tts-2.0；换回克隆主播填 S_6uN8A8f22（走下面的 RESOURCE_ID / MODEL）
VOLCENGINE_TTS_SPEAKER=zh_male_baqiqingshu_uranus_bigtts
VOLCENGINE_TTS_RESOURCE_ID=seed-icl-2.0
# 只对复刻音色生效：expressive 支持导演给的语气指令和句内情绪标签；standard 更稳但平
VOLCENGINE_TTS_MODEL=seed-tts-2.0-expressive
# 按导演稿给每段加语气、给转折句加情绪；0 = 平读
VOLCENGINE_TTS_EMOTION=1
# 语速：SPEECH_RATE 是豆包原生语速（-50~100，100=2倍），ATEMPO 是合成后再整体提速
VOLCENGINE_TTS_SPEECH_RATE=20
VOLCENGINE_TTS_ATEMPO=1.18

AIVIDEO_BRAND_NAME="AI财知道"
AIVIDEO_BRAND_TAGLINE="每天一个 AI 财经为什么"
AIVIDEO_OUTRO_HEADLINE="点赞 · 收藏 · 关注"
AIVIDEO_OUTRO_NARRATION="有用就收藏。"
AIVIDEO_OUTRO_SUBLINE="一起看懂 AI 和钱的事"
AIVIDEO_BGM_VOLUME=0.5

# 只发抖音；其余平台要开就在 .env 里写同名一行 =1
AIVIDEO_PUBLISH_LLM_BROWSER=1
AIVIDEO_PUBLISH_DOUYIN=1
AIVIDEO_PUBLISH_EASTMONEY=0
AIVIDEO_PUBLISH_XUEQIU=0
AIVIDEO_PUBLISH_SHIPINHAO=0
AIVIDEO_PUBLISH_XHS=0
AIVIDEO_PUBLISH_ZHIHU=0
AIVIDEO_PUBLISH_BILIBILI=0
AIVIDEO_PUBLISH_WECHAT=0
ZHIHU_AUTO_PUBLISH=0

BILIBILI_TID=207
DOUYIN_HASHTAGS="#AI #人工智能 #科技资讯 #大模型"
XHS_HASHTAGS="#财经 #股市 #投资 #AI #美股"
SHIPINHAO_HASHTAGS="#财经 #股市 #投资 #AI"
DOUYIN_DECLARE_AI=0
AIVIDEO_XHS_GOTO_TIMEOUT_MS=90000
LLM_BROWSER_RECONCILE_WAIT=30
LLM_BROWSER_PROFILE_SETTLE=8
