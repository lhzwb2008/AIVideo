<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd 每日 10:00 定时任务
  安装：
    cp launchd/com.aivideo.daily.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.aivideo.daily.plist 2>/dev/null || true
    launchctl load   ~/Library/LaunchAgents/com.aivideo.daily.plist

  立刻试跑一次：
    launchctl start com.aivideo.daily

  查看日志：
    tail -f logs/daily_run.log
    tail -f logs/daily_stderr.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aivideo.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Wezhang/workspace/AIVideo/run-daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Wezhang/workspace/AIVideo</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/Wezhang/workspace/AIVideo/logs/daily_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Wezhang/workspace/AIVideo/logs/daily_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
</dict>
</plist>
