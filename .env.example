# 复制为 .env 后填入真实值，切勿提交 .env
# cp .env.example .env

# --- Coze 服务身份凭证 (SAT) ---
# 扣子 → API & SDK → 授权 → 服务身份凭证
# 用于调用已发布工作流、Bot 对话等（需开通 run 等权限）
COZE_API_TOKEN=
COZE_API_BASE=https://api.coze.cn

# 在 Coze 工作流 URL 里 workflow_id= 后面的数字
COZE_WORKFLOW_ID=7641981453953204264
COZE_SPACE_ID=7522025257893412902
COZE_WORKFLOW_TOPIC=今日AI新闻

# 若工作流要求关联智能体，填 bot 页面 URL 里的 bot id（可选）
# COZE_BOT_ID=

# --- 阿里云百炼 / DashScope（OpenAI 兼容）---
# 用于脚本生成、TTS（CosyVoice 等）、图像等
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
