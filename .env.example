# cp .env.example .env 并填入密钥
# 其余配置（模型、配音、品牌、发布平台等）都在 config/defaults.env，随 git pull 自动更新。
# 要覆盖某项默认值，在本文件里写同名一行即可（如 AIVIDEO_MAX_VIDEOS_PER_RUN=4）。
# 已有完整旧 .env 的机器：.\scripts\slim-env.ps1 对比，确认后加 -Apply 精简。
# Windows：docs/WINDOWS-DEPLOY.md

CURSOR_API_KEY=
CURSOR_SANDBOX_REPO_URL=
AIHUBMIX_API_KEY=
VOLCENGINE_TTS_API_KEY=
DASHSCOPE_API_KEY=
EXA_API_KEY=

# Windows 服务器填 sau.exe 路径
SAU_BIN=

# 微信公众号（AIVIDEO_PUBLISH_WECHAT=1 时）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# 吉祥物片头走 OSS 时
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_PREFIX=
# OSS_REGION=oss-cn-shanghai
# OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
