# cp .env.example .env
# 单文件分块配置（由 scripts/load-dotenv.sh 解析）：
#   #== section: shared ==  共享 API 密钥与通用参数（永远加载）
#   #== section: zh ==      中文流水线（./make-and-publish.sh）
#   #== section: en ==      英文 US Market（./make-us-publish.sh）
# 同名变量：语言分块覆盖 shared 默认值。分块标记行格式勿改
# 入口脚本会自动 source scripts/load-dotenv.sh zh|en
# Windows 服务器：见 docs/WINDOWS-DEPLOY.md，运行 .\setup-windows.ps1

# 默认话题（不传参数时使用）
AIVIDEO_TOPIC=AI财经为什么

# Cursor Cloud Agents（./make-and-publish.sh 五槽位联网写稿）
CURSOR_API_KEY=
CURSOR_SANDBOX_REPO_URL=https://github.com/your-org/your-sandbox-repo
# Cloud Agents：grok-4.5 / composer-2.5（以 GET /v1/models 为准；勿用 cursor-grok-4.5-high）
CURSOR_MODEL_ID=grok-4.5
# 同一次日更里复用同一个 Cloud Agent（1=开，省创建时间；0=每条新建）
AIVIDEO_CURSOR_REUSE_AGENT=1
# createAgent 遇 GitHub 429 等限流时自动重试次数（默认 6；按 retryAfter≈60s 等待）
# CURSOR_HTTP_MAX_RETRIES=6
# 中文流水线：合规略放宽，不单禁口播里的「买入」「卖出」二字
AIVIDEO_COMPLIANCE_RELAXED=1
# 临时试验开关：=1 时完全跳过合规校验与 5 次重试修正（不检查违禁词/股票代码），
# AI 生成什么就直接拿去发布，出问题风险自负。默认关闭。
# AIVIDEO_SKIP_COMPLIANCE=1

# AiHubMix 生图（gpt-image-2）
AIHUBMIX_API_KEY=
# aihubmix.com 在国内/部分云服务器 HTTPS 易超时；备用：https://api.inferera.com/v1
AIHUBMIX_BASE_URL=https://api.inferera.com/v1
AIHUBMIX_IMAGE_MODEL=gpt-image-2
AIHUBMIX_IMAGE_SIZE=1024x1536
# low ≈30–60s/张；high ≈200s+。短视频背景图 low 通常足够
AIHUBMIX_IMAGE_QUALITY=low
AIHUBMIX_IMAGE_TIMEOUT=300
# 控成本：单条视频最多正文页数（默认 4）。再加 1 张全屏封面海报 = 总共 ≤5 张图
AIVIDEO_MAX_SLIDES=4
# 是否生成全屏 AI 封面海报（成片开场 + 平台首帧；默认开）
AIVIDEO_AI_COVER=1
# 中文数字人片头（默认开，接在冷开场前；英文流水线自动跳过）
# 每期无嘴物体吉祥物；默认剪纸点头动画（万相 I2V 容易长出脸和口罩，默认关）
# AIVIDEO_HOST_INTRO=1
# AIVIDEO_HOST_INTRO_REUSE_STILL=0
# AIVIDEO_HOST_INTRO_I2V=0
# 正文页标注：闪光短箭头圈/划当前口播对应的 on_image_text（默认开）
# AIVIDEO_LECTURE_POINTER=1
# AIVIDEO_LECTURE_POINTER_VISION=1
# AIVIDEO_POINTER_VISION_MODEL=qwen-vl-plus
# 箭头相对原尺寸的放大倍数（默认 2.2）
# AIVIDEO_POINTER_SCALE=2.2

# TTS：默认豆包声音复刻；改成 dashscope 可切回百炼 CosyVoice
TTS_PROVIDER=doubao

# 豆包 / 火山引擎 TTS（声音复刻 ICL2.0）
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_RESOURCE_ID=seed-icl-2.0
VOLCENGINE_TTS_SPEAKER=S_6uN8A8f22
VOLCENGINE_TTS_MODEL=seed-tts-2.0-standard
VOLCENGINE_TTS_UID=aivideo
VOLCENGINE_TTS_FORMAT=mp3
VOLCENGINE_TTS_SAMPLE_RATE=24000
VOLCENGINE_TTS_RATE=1.0
VOLCENGINE_TTS_SPEECH_RATE=0
VOLCENGINE_TTS_LOUDNESS_RATE=0
VOLCENGINE_TTS_ATEMPO=1.18

# 百炼 DashScope（OpenAI 兼容 chat + TTS）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 阿里云 OSS（与 english-test 同一套；万相对口型口播走签名 HTTPS URL）
# 密钥勿提交 Git。Bucket 私有请用 signed。
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=nba-dev-sh
# OSS_PREFIX=wenbo
# OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# OSS_REGION=oss-cn-shanghai
# OSS_URL_MODE=signed
# OSS_SIGNED_URL_SECONDS=604800
# OSS_PUBLIC_BASE_URL=
# 通用文本模型（Hermes Agent 等）
DASHSCOPE_MODEL=qwen3.7-max
# LLM 浏览器发布（抖音/视频号/小红书）：AiHubMix Opus，确定性填表优先，LLM 仅兜底
# LLM 浏览器发布（抖音/视频号/小红书）：默认 Opus（AiHubMix，20 步）；Qwen 可设 LLM_BROWSER_MODEL=qwen3.7-max
# LLM_BROWSER_USE_PROFILE=1  # 默认开：复用 browser_profiles/* 持久登录（视频号推荐）
# AIVIDEO_USE_CHROME_CDP=1  # 默认开：
#   启动/保活一个常驻真实 Chrome（非 Playwright launch），抖音/小红书浏览器发布
#   通过 connect_over_cdp() 接管。中途挂掉会自动重启同一 chrome-cdp-profile。
#   设为 0 可回退为旧的 launch()/launch_persistent_context() 方式。
# AIVIDEO_CHROME_CDP_PORT=9222       # 常驻 Chrome 的调试端口
# AIVIDEO_CHROME_CDP_PROFILE=chrome-cdp-profile  # 常驻 Chrome 的用户数据目录
# AIVIDEO_CHROME_CDP_URL=            # 由流水线自动设置，无需手填
# LLM_BROWSER_PROFILE_SETTLE=8       # 平台切换冷却秒数（CDP 模式建议 >=8）
# LLM_BROWSER_MODEL=claude-opus-4-8
# LLM_BROWSER_MAX_STEPS=20  # Opus 默认 20；Qwen 默认 30
# LLM_BROWSER_DETERMINISTIC=1
# LLM_BROWSER_SAVE_SCREENSHOTS=0
# LLM_BROWSER_SUCCESS_WAIT=45       # 子进程结束后轮询成功日志（秒），防误重试
# LLM_BROWSER_RECONCILE_WAIT=25     # 流水线判失败后先核对日志（秒）
# LLM_BROWSER_STAMP_COOLDOWN=180    # 同视频重复启动发布前冷却（秒），防小红书双发
# XHS_PUBLISH_SUCCESS_WAIT=20       # 小红书发布后等待 URL/页面确认（秒）
# XHS_PUBLISH_POST_CLICK_WAIT=15    # 点击发布后等待 published=true（秒）
# section zh 内开启 LLM 自动发布（需先 ./douyin-login.sh / ./social-login.sh）：
# AIVIDEO_PUBLISH_DOUYIN=1
# AIVIDEO_PUBLISH_XHS=1
# AIVIDEO_PUBLISH_SHIPINHAO=1
DASHSCOPE_TTS_MODEL=cosyvoice-v2
# 可填官方音色（如 longshu_v2）或克隆音色 ID（cosyvoice-v2-xxx-yyy）
DASHSCOPE_TTS_VOICE=longshu_v2
DASHSCOPE_TTS_FORMAT=mp3
DASHSCOPE_TTS_SAMPLE_RATE=24000
# TTS 用 1.0 自然生成，再用 ffmpeg atempo 做最终提速
DASHSCOPE_TTS_RATE=1.0
DASHSCOPE_TTS_ATEMPO=1.18
# 英文缩写转中文读法（ASIC→专用集成电路 等）
DASHSCOPE_TTS_PREPROCESS=1
# 可选：SSML 在标点处插入停顿；默认关闭，避免气口过重
DASHSCOPE_TTS_SSML=0
# 可选：按句分段合成再拼接；默认关闭，避免拼接气口不自然
DASHSCOPE_TTS_SEGMENT=0

# 本地视频合成
AIVIDEO_FONT=assets/HiraginoSansGB.ttc
# 冷开场：口播 cold_open + 底部字幕跟读；封面用原标题海报（不把钩子大字印在封面上）
# 吉祥物片头接在封面之后；正文页闪光箭头仍在
# 片头 AIVIDEO_COVER_DURATION_S 秒只播口播、不叠底部字幕（语音正常），便于平台取干净封面
# 冷开场动效：只做画面动效，字幕仍走底部分句跟读；off | zoom_punch | news_flash | impact | auto
AIVIDEO_COLD_OPEN_FX=impact
AIVIDEO_COLD_OPEN_MIN_S=2.5
# 仅用于无 TTS 音频时按文字估算时长；有音频时会按真实音频长度走，避免裁掉口播尾巴
AIVIDEO_COLD_OPEN_MAX_S=4.5
AIVIDEO_COLD_OPEN_AUDIO_MAX_S=8.0
# 仅当脚本无 cold_open 时的旧版静音封面帧（秒）；0=跳过
AIVIDEO_COVER_DURATION_S=0.8
# 概念簇去重：近 N 天同簇上限（支持一天多次 ./make-and-publish.sh 1 累计）
AIVIDEO_THEME_DEDUP_DAYS=30
AIVIDEO_THEME_MAX_PER_DAY=1
# 发布前预审：1=拦截 blocking 项（荐股/代码/保证收益等）；0=仅打印警告
AIVIDEO_DOUYIN_COMPLIANCE_STRICT=1
AIVIDEO_BRAND_NAME="AI财知道"
AIVIDEO_BRAND_TAGLINE="每天一个 AI 财经为什么"
AIVIDEO_OUTRO_NARRATION="我是AI财知道，每天用大白话讲清一个AI和财经热点。觉得有用就收藏下来对照看盘用，也欢迎点个关注，下条更新别错过！"
AIVIDEO_OUTRO_SUBLINE="一起看懂 AI 和钱的事"
# 背景音乐：默认从 assets/bgm 自动轮换；口播时自动 ducking，避免盖住人声
AIVIDEO_BGM_ENABLED=1
AIVIDEO_BGM_DIR=assets/bgm
AIVIDEO_BGM_VOLUME=0.35
AIVIDEO_BGM_FADE_S=1.2
AIVIDEO_BGM_DUCKING=0
AIVIDEO_BGM_DUCK_THRESHOLD=0.12
AIVIDEO_BGM_DUCK_RATIO=2.5
AIVIDEO_BGM_VOICE_VOLUME=1.0
# 近 N 天发布/制作历史用于本地硬去重 + 提醒模型规避
BATCH_HISTORY_DAYS=7
AIVIDEO_DAYS=7
# 每次制作发布条数（中文工作日默认 5 槽位，周末默认 3 条科普；见 AIVIDEO_WEEKEND_MAX_VIDEOS）
AIVIDEO_MAX_VIDEOS_PER_RUN=5
# 周末科普：近 N 天同话题/概念硬去重（默认 3650≈十年，科普概念近似永不重复）
AIVIDEO_EDU_DEDUP_DAYS=3650
# 选题历史文件保留天数（默认至少覆盖科普去重窗口）
# AIVIDEO_HISTORY_RETENTION_DAYS=3650
AIVIDEO_WEEKEND_MAX_VIDEOS=3
# AIVIDEO_FORCE_WEEKEND_EDU=1  # 强制走周末科普模式（调试用）
# AIVIDEO_FORCE_WEEKDAY=1      # 周末也强制走工作日新闻槽位
# 小红书 cookie 校验打开创作页的超时（毫秒）；网络慢时可调到 120000
AIVIDEO_XHS_GOTO_TIMEOUT_MS=90000
# 信息源：中文流水线由 make-and-publish.sh 设为 cursor；Exa 仅作遗留调试
AIVIDEO_SOURCE=cursor

# 成本估算（仅供参考，按 AiHubMix 实际账单为准）；单位 USD / 每百万 token
OPUS_PRICE_INPUT_PER_M=15
OPUS_PRICE_OUTPUT_PER_M=75
IMAGE_PRICE_PER_IMAGE=0
IMAGE_PRICE_INPUT_PER_M=5
IMAGE_PRICE_OUTPUT_PER_M=40
USD_TO_CNY=7.2
# 抖音顶部 UI 安全区：品牌角标默认下移，避免被返回按钮/状态栏遮挡
AIVIDEO_BRAND_BADGE_X=86
AIVIDEO_BRAND_BADGE_Y=150
# 正文页生成图整体下移，顶部留给抖音状态栏/搜索/返回按钮
AIVIDEO_IMAGE_TOP_SAFE_Y=150

# 发布渠道开关（0=关 1=开）仅写在 #== section: zh == / en == 分块；未设置=关
# 账号 cookie 后缀见下方 SAU_* / *_ACCOUNT
# 留空则默认 vendor/social-auto-upload；Windows B站发布需 sau.exe：
# SAU_BIN=C:/Users/你/AIVideo/vendor/social-auto-upload/.venv/Scripts/sau.exe
SAU_HOME=
SAU_BIN=
SAU_DOUYIN_ACCOUNT=main
SAU_BILIBILI_ACCOUNT=main
# 国内服务器首次下载 biliup 时可设 GitHub 镜像（B站登录/发布）
# GH_PROXY=https://ghproxy.net
SAU_XHS_ACCOUNT=main
SAU_KUAISHOU_ACCOUNT=main
SAU_SHIPINHAO_ACCOUNT=main
EASTMONEY_ACCOUNT=main
# 东方财富长文默认活动话题；留空则不加
EASTMONEY_DEFAULT_TOPIC=社区牛人计划
XUEQIU_ACCOUNT=main
ZHIHU_ACCOUNT=main
# 微信公众号：mp.weixin.qq.com → 设置 → 开发接口管理
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_DRAFT_ONLY=1  # 默认仅存草稿箱；需自动发表时在 publish-wechat.sh 加 --publish
# 知乎专栏：./zhihu-login.sh 后在 section zh 设 AIVIDEO_PUBLISH_ZHIHU=1
# ZHIHU_AUTO_PUBLISH=1  # 填表后直接点发布（=0 仅存草稿，需手动发布）
# ZHIHU_BROWSER_HEADLESS=0  # 填表失败时可开有头浏览器调试

# ── 发布话题 / 标签 ─────────────────────────────────────────────
DOUYIN_HASHTAGS=#AI #人工智能 #财经 #美股 #中概股
XHS_HASHTAGS=#财经 #股市 #投资 #AI #美股
SHIPINHAO_HASHTAGS=#财经 #股市 #投资 #AI

# ── 发布高级配置（代理、分区、抖音填表等）────────────────────────
# 登录脚本见各平台注释块（douyin-login / bilibili-login 等）
BILIBILI_TID=207
AIVIDEO_XHS_GOTO_TIMEOUT_MS=90000
# 抖音（./douyin-login.sh；AIVIDEO_PUBLISH_DOUYIN=1 → publish-llm-browser.sh douyin）
DOUYIN_TITLE_PREFIX=0
DOUYIN_DESC_SUFFIX=
DOUYIN_DECLARE_AI=0
XHS_DESC_SUFFIX=
SHIPINHAO_DESC_SUFFIX=
SHIPINHAO_CATEGORY=
# BILIBILI_SKIP_VIDEO=1  # 跳过 biliup 视频上传，改在创作中心手动传
# 合成后自动生成论坛图文包（output/<视频名>/），归档时与 mp4 一并进入 archive/published/日期/
# 配图默认复用视频分镜图（images/01.jpg…），不额外生图；正文按分镜叙事、书面改写口播（非口播直贴）
# AIVIDEO_FORUM_PRO_ARTICLE=0  # 关闭 LLM，回退为口播扩展稿（旧逻辑）
# AIVIDEO_FORUM_ALLOW_FALLBACK=1  # LLM 失败时回退口播扩展稿，否则中止
# AIVIDEO_FORUM_ARTICLE_MIN_CHARS=1000
# AIVIDEO_FORUM_SECTION_MIN_CHARS=120
AIVIDEO_FORUM_POST=1
# 论坛横封面 16:9（cover_landscape.jpg，雪球首页推荐用）：默认 1280x720，裁剪焦点 0.38（偏上对准标题）
# AIVIDEO_FORUM_LANDSCAPE_W=1280
# AIVIDEO_FORUM_LANDSCAPE_H=720
# AIVIDEO_FORUM_LANDSCAPE_FOCUS_Y=0.38
# ── 语言专属配置见本文件分块 ──────────────────────────────────────
# section zh  中文品牌/克隆音色/国内发布开关 → make-and-publish*.sh
# section en  英文品牌/Tim 音色/YouTube+TikTok → make-us-publish.sh
# 归档路径：archive/published/YYYYMMDD/zh|en/
# 工作目录：logs/zh|en/  output/zh|en/

# ── YouTube Shorts（.env.en / make-us-publish.sh 专用）────────────
# US 凭证目录 credentials/us/（本地 + scp，勿 git push；GitHub 会拦截 OAuth）
# 服务器首次: ./setup-linux-us.sh
# 本地: ./scripts/us-credentials.sh --pack
# 服务器: ./scripts/unpack-us-credentials.sh /path/to/us-bundle-*.tar.gz
# 定时:   ./scripts/register-daily-us-publish.sh   # 每天北京时间 05:00
# 安装: ./setup-youtube.sh
# 授权: ./youtube-login.sh
# 校验: ./youtube-login.sh --check
# 发布: ./scripts/publish-youtube.sh output/xxx.mp4 --script logs/last_script_xxx.json
# OAuth 凭据（Google Cloud 桌面应用 JSON）→ credentials/youtube/client_secret.json
# YOUTUBE_CLIENT_SECRETS=
# YOUTUBE_ACCOUNT=main
# YOUTUBE_PRIVACY=public
# YOUTUBE_CATEGORY_ID=25
# YOUTUBE_HASHTAGS=#AI #财经 #美股 #中概股 #Shorts
# YOUTUBE_DESC_SUFFIX=
# YOUTUBE_DISCLAIMER=本内容仅供学习交流，不构成投资建议。
# YOUTUBE_ADD_SHORTS_TAG=1

# ── TikTok Direct Post（.env.en / make-us-publish.sh 专用）────────
# 过审材料（落地页/隐私/演示）：tiktok-app-review/（已 gitignore）
# 安装: ./setup-tiktok.sh
# 授权: ./tiktok-login.sh
# 校验: ./tiktok-login.sh --check
# 发布: ./scripts/publish-tiktok.sh output/xxx.mp4 --script logs/last_script_xxx.json
# credentials/tiktok/client.json ← 参考 client.json.example
# Login Kit redirect_uri 须注册: http://127.0.0.1:8765/callback/
# TIKTOK_ACCOUNT=main
# TIKTOK_OAUTH_PORT=8765
# TIKTOK_REDIRECT_URI=http://127.0.0.1:8765/callback/
# TIKTOK_SCOPES=user.info.basic,video.upload          # 仅 video.upload：流水线自动跳过 TikTok
# TIKTOK_SCOPES=user.info.basic,video.upload,video.publish
# US_SOCIAL_PREFLIGHT_COUNT=0   # 默认跳过 IG/FB 发布前主页统计（省时；以 UI 成功为准）
# US_SOCIAL_PREFLIGHT_COUNT=1   # 发布前数 reels 再比对
# TIKTOK_PRIVACY=SELF_ONLY
#   未过 App Review 时 TikTok 通常只允许 SELF_ONLY；过审后可改 PUBLIC_TO_EVERYONE
# US Market 英文 TTS（见 assets/us-voices.json；默认 tim = en_male_tim 美式原生男声）
# US_TTS_VOICE=tim
# VOLCENGINE_TTS_ATEMPO=1.08
# AIVIDEO_MAX_VIDEO_DURATION_S=180
# TIKTOK_HASHTAGS=#AI #finance #stocks #Shorts
# TIKTOK_DISCLAIMER=For education only. Not investment advice.
# TIKTOK_DECLARE_AIGC=0
