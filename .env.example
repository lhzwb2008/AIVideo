# cp .env.example .env

# 扣子编程（合成阶段）
COZE_VIBE_RUN_URL=https://你的子域.coze.site/run
COZE_VIBE_GRAPH_URL=https://你的子域.coze.site/graph_parameter
COZE_VIBE_API_TOKEN=
COZE_VIBE_INPUT_KEY=input
# 视频合成约 5–8 分钟，建议用流式 API 避免 504（需重新部署后才可用 /run/stream）
COZE_VIBE_USE_STREAM=1
COZE_WORKFLOW_TOPIC=AI热点深度

# AiHubMix 生图（调研后、Coze 合成前；Coze 只负责 TTS + 视频合成）
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_IMAGE_MODEL=gpt-image-2
AIHUBMIX_IMAGE_SIZE=1024x1536
AIHUBMIX_IMAGE_QUALITY=low
# low 约 90–100s/张，high 约 200s+；短视频背景图 low 通常够用
AIHUBMIX_IMAGE_TIMEOUT=300
# 上传到 catbox 供 Coze 云端下载；设为 none 则改用 image_b64（JSON 较大）
AIVIDEO_IMAGE_UPLOAD=catbox
AIVIDEO_IMAGE_INCLUDE_B64=0

# Cursor Cloud Agents（本地调研）
CURSOR_API_KEY=
CURSOR_SANDBOX_REPO_URL=https://github.com/your-org/your-sandbox-repo
CURSOR_MODEL_ID=composer-2

# 抖音发布（手动执行 ./publish-all-douyin.sh，见 ./douyin-login.sh）
SAU_HOME=
SAU_BIN=
SAU_DOUYIN_ACCOUNT=main
DOUYIN_HASHTAGS=#AI #人工智能 #科技资讯 #大模型
DOUYIN_DESC_SUFFIX=
# SAU_HEADED=1
# SAU_HEADLESS=1
