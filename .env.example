# cp .env.example .env

# --- 扣子编程「AI新闻60秒」已部署 API（主流程）---
COZE_VIBE_BASE_URL=https://你的子域.coze.site
COZE_VIBE_RUN_URL=https://你的子域.coze.site/run
COZE_VIBE_GRAPH_URL=https://你的子域.coze.site/graph_parameter
COZE_VIBE_API_TOKEN=
COZE_VIBE_INPUT_KEY=input
COZE_WORKFLOW_TOPIC=今日AI新闻

# --- 阿里云百炼（备用工具，非主流程）---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
