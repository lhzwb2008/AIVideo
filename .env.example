# cp .env.example .env

# 默认话题（不传参数时使用）
AIVIDEO_TOPIC=AI财经为什么

# Cursor Cloud Agents（./make-and-publish-new.sh 五槽位联网写稿）
CURSOR_API_KEY=
CURSOR_SANDBOX_REPO_URL=https://github.com/your-org/your-sandbox-repo
CURSOR_MODEL_ID=composer-2.5
# 同一次日更里复用同一个 Cloud Agent（1=开，省创建时间；0=每条新建）
AIVIDEO_CURSOR_REUSE_AGENT=1
# 仅 make-and-publish-new.sh：合规略放宽，不单禁口播里的「买入」「卖出」二字
AIVIDEO_COMPLIANCE_RELAXED=1

# AiHubMix 生图（gpt-image-2）
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_IMAGE_MODEL=gpt-image-2
AIHUBMIX_IMAGE_SIZE=1024x1536
# low ≈30–60s/张；high ≈200s+。短视频背景图 low 通常足够
AIHUBMIX_IMAGE_QUALITY=low
AIHUBMIX_IMAGE_TIMEOUT=300
# 控成本：单条视频最多正文页数（默认 4）。再加 1 张全屏封面海报 = 总共 ≤5 张图
AIVIDEO_MAX_SLIDES=4
# 是否生成全屏 AI 封面海报（默认开，是必要的封面钩子）
AIVIDEO_AI_COVER=1

# TTS：默认豆包声音复刻；改成 dashscope 可切回百炼 CosyVoice
TTS_PROVIDER=doubao

# 豆包 / 火山引擎 TTS（声音复刻 ICL2.0）
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_RESOURCE_ID=seed-icl-2.0
VOLCENGINE_TTS_SPEAKER=S_6uN8A8f22
VOLCENGINE_TTS_MODEL=seed-tts-2.0-standard
VOLCENGINE_TTS_UID=aivideo
VOLCENGINE_TTS_FORMAT=mp3
VOLCENGINE_TTS_SAMPLE_RATE=24000
VOLCENGINE_TTS_RATE=1.0
VOLCENGINE_TTS_SPEECH_RATE=0
VOLCENGINE_TTS_LOUDNESS_RATE=0
VOLCENGINE_TTS_ATEMPO=1.18

# 百炼 DashScope TTS（CosyVoice，TTS_PROVIDER=dashscope 时使用）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_TTS_MODEL=cosyvoice-v2
# 可填官方音色（如 longshu_v2）或克隆音色 ID（cosyvoice-v2-xxx-yyy）
DASHSCOPE_TTS_VOICE=longshu_v2
DASHSCOPE_TTS_FORMAT=mp3
DASHSCOPE_TTS_SAMPLE_RATE=24000
# TTS 用 1.0 自然生成，再用 ffmpeg atempo 做最终提速
DASHSCOPE_TTS_RATE=1.0
DASHSCOPE_TTS_ATEMPO=1.18
# 英文缩写转中文读法（ASIC→专用集成电路 等）
DASHSCOPE_TTS_PREPROCESS=1
# 可选：SSML 在标点处插入停顿；默认关闭，避免气口过重
DASHSCOPE_TTS_SSML=0
# 可选：按句分段合成再拼接；默认关闭，避免拼接气口不自然
DASHSCOPE_TTS_SEGMENT=0

# 本地视频合成
AIVIDEO_FONT=assets/HiraginoSansGB.ttc
# 冷开场：口播 cold_open + 底部字幕跟读；封面仍用原标题图（不把钩子大字印在封面上）
# 片头 AIVIDEO_COVER_DURATION_S 秒只播口播、不叠底部字幕（语音正常），便于平台取干净封面
# 冷开场动效：只做画面动效，字幕仍走底部分句跟读；off | zoom_punch | news_flash | impact | auto
AIVIDEO_COLD_OPEN_FX=impact
AIVIDEO_COLD_OPEN_MIN_S=2.5
# 仅用于无 TTS 音频时按文字估算时长；有音频时会按真实音频长度走，避免裁掉口播尾巴
AIVIDEO_COLD_OPEN_MAX_S=4.5
AIVIDEO_COLD_OPEN_AUDIO_MAX_S=8.0
# 仅当脚本无 cold_open 时的旧版静音封面帧（秒）；0=跳过
AIVIDEO_COVER_DURATION_S=0.8
# 概念簇去重：近 N 天同簇上限（支持一天多次 ./make-and-publish.sh 1 累计）
AIVIDEO_THEME_DEDUP_DAYS=7
AIVIDEO_THEME_MAX_PER_DAY=1
# 发布前预审：1=拦截 blocking 项（荐股/代码/保证收益等）；0=仅打印警告
AIVIDEO_DOUYIN_COMPLIANCE_STRICT=1
AIVIDEO_BRAND_NAME="AI财知道"
AIVIDEO_BRAND_TAGLINE="每天一个 AI 财经为什么"
AIVIDEO_OUTRO_NARRATION="我是AI财知道，每天用大白话讲清一个AI和财经热点。觉得有用就收藏下来对照看盘用，也欢迎点个关注，下条更新别错过！"
AIVIDEO_OUTRO_SUBLINE="一起看懂 AI 和钱的事"
# 背景音乐：默认从 assets/bgm 自动轮换；口播时自动 ducking，避免盖住人声
AIVIDEO_BGM_ENABLED=1
AIVIDEO_BGM_DIR=assets/bgm
AIVIDEO_BGM_VOLUME=0.35
AIVIDEO_BGM_FADE_S=1.2
AIVIDEO_BGM_DUCKING=0
AIVIDEO_BGM_DUCK_THRESHOLD=0.12
AIVIDEO_BGM_DUCK_RATIO=2.5
AIVIDEO_BGM_VOICE_VOLUME=1.0
# 近 7 天发布/制作历史用于本地硬去重 + 提醒模型规避；同公司同财报/股价事件会被拦截
BATCH_HISTORY_DAYS=7
# 每日自动：发现热点候选的时间窗（天）
AIVIDEO_DAYS=7
# 每条问句话题搜文的时间窗（天）；科普向手动话题可用 120
AIVIDEO_TOPIC_DAYS=7
# 每次制作发布条数（可任意正整数，与下方比例联动）
AIVIDEO_MAX_VIDEOS_PER_RUN=3
# 三方向目标占比 astock,ai,hkus（可不必加总为 1，会自动归一化；默认 55/25/20）
AIVIDEO_DIR_RATIO=0.55,0.25,0.20
# A股最少占比（严格大于该值：3 条→至少 2 条 A股，5 条→至少 3 条）
AIVIDEO_ASTOCK_MIN_RATIO=0.5
# 新闻类话题：Exa 最新候选超过该天数则综合材料自写
AIVIDEO_TOPIC_FRESH_DAYS=2
# 每日选题：送入「提炼问句」的热点候选上限
AIVIDEO_PROPOSE_MAX_CANDIDATES=28
# 小红书 cookie 校验打开创作页的超时（毫秒）；网络慢时可调到 120000
AIVIDEO_XHS_GOTO_TIMEOUT_MS=90000
# 信息源：统一使用 Exa Search（AI + 财经 + 财报）
AIVIDEO_SOURCE=exa
# 指定话题模式（./make-topics.sh）搜话题文章的时间窗（天）
AIVIDEO_TOPIC_DAYS=120

# 成本估算（仅供参考，按 AiHubMix 实际账单为准）；单位 USD / 每百万 token
OPUS_PRICE_INPUT_PER_M=15
OPUS_PRICE_OUTPUT_PER_M=75
IMAGE_PRICE_PER_IMAGE=0
IMAGE_PRICE_INPUT_PER_M=5
IMAGE_PRICE_OUTPUT_PER_M=40
USD_TO_CNY=7.2
# 抖音顶部 UI 安全区：品牌角标默认下移，避免被返回按钮/状态栏遮挡
AIVIDEO_BRAND_BADGE_X=86
AIVIDEO_BRAND_BADGE_Y=150
# 正文页生成图整体下移，顶部留给抖音状态栏/搜索/返回按钮
AIVIDEO_IMAGE_TOP_SAFE_Y=150

# ── 发布渠道开关（0=关 1=开；./make-and-publish.sh 读取）──────────
# 视频
AIVIDEO_PUBLISH_DOUYIN=0
AIVIDEO_PUBLISH_BILIBILI=0
AIVIDEO_PUBLISH_BILIBILI_ARTICLE=1
AIVIDEO_PUBLISH_YOUTUBE=0
AIVIDEO_PUBLISH_TIKTOK=0
AIVIDEO_PUBLISH_XHS=0
AIVIDEO_PUBLISH_KS=0
AIVIDEO_PUBLISH_SHIPINHAO=0
# 论坛长文（post.md + cover.jpg + images/）
AIVIDEO_PUBLISH_EASTMONEY=0
AIVIDEO_PUBLISH_XUEQIU=0
AIVIDEO_PUBLISH_WECHAT=0
AIVIDEO_PUBLISH_ZHIHU=0
AIVIDEO_PUBLISH_XHS_ARTICLE=0
# 微信公众号：mp.weixin.qq.com → 设置 → 开发接口管理
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_DRAFT_ONLY=1  # 默认仅存草稿箱；需自动发表时在 publish-wechat.sh 加 --publish

# ── 发布渠道账号（cookie 文件名后缀）──────────────────────────────
SAU_HOME=
SAU_BIN=
SAU_DOUYIN_ACCOUNT=main
SAU_BILIBILI_ACCOUNT=main
SAU_XHS_ACCOUNT=main
SAU_KUAISHOU_ACCOUNT=main
SAU_SHIPINHAO_ACCOUNT=main
EASTMONEY_ACCOUNT=main
# 东方财富长文默认活动话题；留空则不加
EASTMONEY_DEFAULT_TOPIC=社区牛人计划
XUEQIU_ACCOUNT=main
ZHIHU_ACCOUNT=main
# 知乎专栏草稿：./zhihu-login.sh 后 AIVIDEO_PUBLISH_ZHIHU=1
# ZHIHU_BROWSER_HEADLESS=0  # 填表失败时可开有头浏览器调试
# 小红书图文草稿：./social-login.sh xiaohongshu 后 AIVIDEO_PUBLISH_XHS_ARTICLE=1
# XHS_ARTICLE_BROWSER_HEADLESS=0  # 填表失败时可开有头浏览器调试

# ── 发布话题 / 标签 ─────────────────────────────────────────────
DOUYIN_HASHTAGS=#AI #人工智能 #财经 #美股 #中概股
XHS_HASHTAGS=#财经 #股市 #投资 #AI #美股
SHIPINHAO_HASHTAGS=#财经 #股市 #投资 #AI
YOUTUBE_HASHTAGS=#AI #财经 #美股 #中概股 #Shorts
TIKTOK_HASHTAGS=#AI #finance #stocks #Shorts

# ── 发布高级配置（代理、分区、抖音填表等）────────────────────────
# 登录脚本见各平台注释块（douyin-login / bilibili-login 等）
BILIBILI_TID=207
AIVIDEO_XHS_GOTO_TIMEOUT_MS=90000
# 抖音（./douyin-login.sh；AIVIDEO_PUBLISH_DOUYIN 主流程暂未接，见 publish-douyin.sh）
DOUYIN_TITLE_PREFIX=0
DOUYIN_DESC_SUFFIX=
DOUYIN_DECLARE_AI=0
XHS_DESC_SUFFIX=
SHIPINHAO_DESC_SUFFIX=
SHIPINHAO_CATEGORY=
# BILIBILI_SKIP_VIDEO=1  # 仅跳过 biliup 视频，专栏仍自动；视频改在创作中心手动传
# B站专栏：AIVIDEO_PUBLISH_BILIBILI_ARTICLE=0 可只发视频
# BILIBILI_ARTICLE_TYPE=3
#   3=opus JSON（创作中心新版，默认）；0=HTML 旧版
# BILIBILI_ARTICLE_CATEGORY=4
# BILIBILI_ARTICLE_TAGS=
# BILIBILI_ARTICLE_AID=0
#   填已有草稿 aid 可覆盖更新；未填时同 pack 会复用 logs/last_bilibili_publish.json 中的 aid
# BILIBILI_ARTICLE_AUTO_PUBLISH=0
#   默认仅存专栏草稿；=1 时保存后用浏览器点「发布」
# BILIBILI_ARTICLE_BROWSER_HEADLESS=1
# 合成后自动生成论坛图文包（output/<视频名>/），归档时与 mp4 一并进入 archive/published/日期/
# 配图默认复用视频分镜图（images/01.jpg…），不额外生图；正文按分镜叙事、书面改写口播（非口播直贴）
# AIVIDEO_FORUM_PRO_ARTICLE=0  # 关闭 LLM，回退为口播扩展稿（旧逻辑）
# AIVIDEO_FORUM_ALLOW_FALLBACK=1  # LLM 失败时回退口播扩展稿，否则中止
# AIVIDEO_FORUM_ARTICLE_MIN_CHARS=1000
# AIVIDEO_FORUM_SECTION_MIN_CHARS=120
AIVIDEO_FORUM_POST=1
# 论坛横封面 16:9（cover_landscape.jpg，雪球首页推荐用）：默认 1280x720，裁剪焦点 0.38（偏上对准标题）
# AIVIDEO_FORUM_LANDSCAPE_W=1280
# AIVIDEO_FORUM_LANDSCAPE_H=720
# AIVIDEO_FORUM_LANDSCAPE_FOCUS_Y=0.38
# YouTube 需先 ./setup-youtube.sh && ./youtube-login.sh（默认直连，无需代理）
# TikTok 需先 ./setup-tiktok.sh && ./tiktok-login.sh；设 AIVIDEO_PUBLISH_TIKTOK=1 启用
# 过审材料（落地页/隐私/演示）：tiktok-app-review/（已 gitignore）

# ── YouTube Shorts（主流程自动发布）──────────────────────────────
# 安装: ./setup-youtube.sh
# 授权: ./youtube-login.sh
# 校验: ./youtube-login.sh --check
# 发布: ./scripts/publish-youtube.sh output/xxx.mp4 --script logs/last_script_xxx.json
# OAuth 凭据（Google Cloud 桌面应用 JSON）→ credentials/youtube/client_secret.json
# YOUTUBE_CLIENT_SECRETS=
# YOUTUBE_ACCOUNT=main
# YOUTUBE_PRIVACY=public
# YOUTUBE_CATEGORY_ID=25
# YOUTUBE_HASHTAGS=#AI #财经 #美股 #中概股 #Shorts
# YOUTUBE_DESC_SUFFIX=
# YOUTUBE_DISCLAIMER=本内容仅供学习交流，不构成投资建议。
# YOUTUBE_ADD_SHORTS_TAG=1
# 国内访问 Google API 时填写本地代理（与终端 export 等价）
# 仅在本机无法直连 Google 时再取消注释（勿设置终端 http_proxy）：
# YOUTUBE_HTTP_PROXY=http://127.0.0.1:7897

# ── TikTok Direct Post（主流程可选）──────────────────────────────
# 安装: ./setup-tiktok.sh
# 授权: ./tiktok-login.sh
# 校验: ./tiktok-login.sh --check
# 发布: ./scripts/publish-tiktok.sh output/xxx.mp4 --script logs/last_script_xxx.json
# credentials/tiktok/client.json ← 参考 client.json.example
# Login Kit redirect_uri 须注册: http://127.0.0.1:8765/callback/
# TIKTOK_ACCOUNT=main
# TIKTOK_OAUTH_PORT=8765
# TIKTOK_REDIRECT_URI=http://127.0.0.1:8765/callback/
# TIKTOK_SCOPES=user.info.basic,video.upload          # 过审前 inbox
# TIKTOK_SCOPES=user.info.basic,video.upload,video.publish
# TIKTOK_POST_MODE=direct   # 过审后直发；过审前用 inbox
# TIKTOK_PRIVACY=SELF_ONLY
#   未过 App Review 时 TikTok 通常只允许 SELF_ONLY；过审后可改 PUBLIC_TO_EVERYONE
# TIKTOK_HASHTAGS=#AI #finance #stocks #Shorts
# TIKTOK_DISCLAIMER=For education only. Not investment advice.
# TIKTOK_DECLARE_AIGC=0
# TIKTOK_HTTP_PROXY=http://127.0.0.1:7897
